# 데이터 소스
DART_API_KEY=
# 네이버 — NAVER API Hub(ncloud, 결제수단 등록 필요). 비워두면 구글 뉴스 RSS 만 사용
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 지오코딩 (카카오 REST API 키 — JavaScript 키 아님)
KAKAO_REST_KEY=
# Neon (GENEQ 계정 프로젝트) 연결 문자열. 비우면 out/ 파일 모드
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# 튜닝
NAVER_MAX_PER_KEYWORD=30
MAX_BODY_CHARS=3000
