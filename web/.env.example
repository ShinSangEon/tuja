# 카카오 개발자센터(GENEQ 비즈 앱) → 앱 키 → JavaScript 키. 플랫폼 Web 에 배포 도메인 + http://localhost:3000 등록
NEXT_PUBLIC_KAKAO_MAP_KEY=
# Neon (GENEQ 계정) 연결 문자열. 비우면 public/sample-signals.json 샘플로 동작
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# 대시보드 접속 아이디/비번 (Basic Auth). 둘 다 비우면 인증 없이 열림 — 로컬에서만
ADMIN_USERNAME=
ADMIN_PASSWORD=
